<section class="troopod-bestsellers">

  <div class="troopod-bestsellers-inner">

    <div class="troopod-bestsellers-heading">

      {% if section.settings.eyebrow != blank %}
        <p class="troopod-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}

    </div>

    {% assign collection = section.settings.collection %}

    {% if collection != blank %}

      <div class="troopod-bestsellers-grid">

        {% for product in collection.products limit: section.settings.products_to_show %}

          <article class="troopod-product-card">

            <a
              href="{{ product.url }}"
              class="troopod-product-card-image"
            >

              {% if product.available == false %}
                <span class="troopod-product-badge">
                  Sold out
                </span>
              {% elsif forloop.index <= 2 %}
                <span class="troopod-product-badge">
                  Bestseller
                </span>
              {% endif %}

              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    widths: '350, 500, 700',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    alt: product.featured_image.alt | default: product.title
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

            </a>

            <div class="troopod-product-card-info">

              <h3>
                <a href="{{ product.url }}">
                  {{ product.title }}
                </a>
              </h3>

              {% if product.metafields.reviews.rating.value != blank %}
                <div class="troopod-product-rating">
                  <strong>
                    ★ {{ product.metafields.reviews.rating.value }}
                  </strong>
                </div>
              {% endif %}

              <div class="troopod-product-price">

                <strong>
                  {{ product.price | money }}
                </strong>

                {% if product.compare_at_price > product.price %}
                  <del>
                    {{ product.compare_at_price | money }}
                  </del>
                {% endif %}

              </div>

              <a
                href="{{ product.url }}"
                class="troopod-product-add"
              >
                {{ section.settings.button_label }}
              </a>

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="page-width">
        <p>Please select a collection in the section settings.</p>
      </div>

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Bestsellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View product"
    }
  ],
  "presets": [
    {
      "name": "Bestsellers"
    }
  ]
}
{% endschema %}
