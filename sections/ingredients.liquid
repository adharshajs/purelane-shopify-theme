<section class="troopod-ingredients" id="ingredients">
  <div class="troopod-section-heading">
    {% if section.settings.eyebrow != blank %}
      <p class="troopod-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h2>{{ section.settings.heading }}</h2>

    <div class="troopod-section-rule">
      <span></span>

      <svg viewBox="0 0 24 24" fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true">
        <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
        <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
      </svg>

      <span></span>
    </div>

    {% if section.settings.description != blank %}
      <p class="troopod-section-description">
        {{ section.settings.description }}
      </p>
    {% endif %}
  </div>

  <div class="troopod-ingredients-grid">
    {% for block in section.blocks %}
      <article class="troopod-ingredient-card" {{ block.shopify_attributes }}>

        <div class="troopod-ingredient-art">
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 300
              | image_tag:
                loading: 'lazy',
                widths: '150, 300',
                sizes: '(min-width: 990px) 180px, 120px',
                alt: block.settings.title
            }}
          {% else %}
            <svg viewBox="0 0 100 100" fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true">

              <circle cx="50" cy="50" r="25"/>
              <path d="M50 25v50"/>
              <path d="M25 50h50"/>
            </svg>
          {% endif %}
        </div>

        {% if block.settings.title != blank %}
          <h3>{{ block.settings.title }}</h3>
        {% endif %}

        {% if block.settings.description != blank %}
          <p>{{ block.settings.description }}</p>
        {% endif %}

      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What's inside"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Plant-derived ingredients chosen to clean effectively while being kinder to your home."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Ingredient name",
          "default": "Coconut"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "title": "Coconut",
            "description": "Plant-derived cleansers that lift grease"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Orange peel",
            "description": "Natural degreaser and fresh citrus lift"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Soap nut",
            "description": "A traditional plant foaming agent"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Neem",
            "description": "Time-tested antibacterial from the tree"
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "title": "Lemongrass",
            "description": "Clean fragrance with nothing synthetic"
          }
        }
      ]
    }
  ]
}
{% endschema %}
