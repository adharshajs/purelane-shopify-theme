<section class="troopod-club" id="club">

  <div class="troopod-club-inner">

    <div class="troopod-club-content">

      <p class="troopod-eyebrow">
        Join the Purelane Club
      </p>

      <h2>
        Get ₹100 off your first bundle
      </h2>

      <p class="troopod-club-description">
        Plus first access to new launches and restocks.
      </p>

      <form class="troopod-club-form" action="#" method="post">

        <label for="club-email" class="visually-hidden">
          Email address
        </label>

        <input
          id="club-email"
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          autocomplete="email"
        >

        <button type="submit">
          Get my ₹100 off
        </button>

      </form>

    </div>

  </div>

</section>