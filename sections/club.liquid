<section class="troopod-club" id="club">

  <div class="troopod-club-inner">

    <div class="troopod-club-content">

      {% if section.settings.eyebrow != blank %}
        <p class="troopod-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="troopod-club-description">
          {{ section.settings.description }}
        </p>
      {% endif %}

      {% form 'customer', class: 'troopod-club-form' %}

        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <label
          for="club-email-{{ section.id }}"
          class="visually-hidden"
        >
          Email address
        </label>

        <input
          id="club-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >

        <button type="submit">
          {{ section.settings.button_label }}
        </button>

        {% if form.posted_successfully? %}
          <p class="form__message">
            {{ section.settings.success_message }}
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="form__message">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

      {% endform %}

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Purelane Club",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my ₹100 off"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in! Check your inbox for your offer."
    }
  ],
  "presets": [
    {
      "name": "Purelane Club"
    }
  ]
}
{% endschema %}
