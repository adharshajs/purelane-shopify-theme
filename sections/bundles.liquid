<section class="troopod-bundles" id="bundles">

  <div class="troopod-bundles-inner">

    <div class="troopod-bundles-heading">

      {% if section.settings.eyebrow != blank %}
        <p class="troopod-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}

    </div>

    <div class="troopod-bundles-grid">

      {% for block in section.blocks %}

        <article
          class="troopod-bundle-card{% if block.settings.featured %} troopod-bundle-featured{% endif %}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.badge != blank %}
            <div class="troopod-bundle-save">
              {{ block.settings.badge }}

              {% if block.settings.badge_label != blank %}
                <span>{{ block.settings.badge_label }}</span>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.products != blank %}
            <div class="troopod-bundle-products">
              {% for product in block.settings.products %}
                <div class="troopod-bundle-product">
                  {{
                    product.featured_image
                    | image_url: width: 180
                    | image_tag:
                      loading: 'lazy',
                      alt: product.title
                  }}
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if block.settings.benefits != blank %}
            <div class="troopod-bundle-benefits">
              {% assign benefits = block.settings.benefits | newline_to_br | split: '<br />' %}

              {% for benefit in benefits %}
                <span>{{ benefit | strip_html | strip }}</span>
              {% endfor %}
            </div>
          {% endif %}

          <h3>{{ block.settings.title }}</h3>

          {% if block.settings.product_count != blank %}
            <strong class="troopod-bundle-count">
              {{ block.settings.product_count }} products
            </strong>
          {% endif %}

          {% if block.settings.description != blank %}
            <p>{{ block.settings.description }}</p>
          {% endif %}

          <div class="troopod-bundle-price">

            {% if block.settings.price != blank %}
              <strong>{{ block.settings.price }}</strong>
            {% endif %}

            {% if block.settings.compare_price != blank %}
              <del>{{ block.settings.compare_price }}</del>
            {% endif %}

            {% if block.settings.saving != blank %}
              <span>{{ block.settings.saving }}</span>
            {% endif %}

          </div>

          {% if block.settings.terms != blank %}
            <small>{{ block.settings.terms }}</small>
          {% endif %}

          {% if block.settings.button_label != blank %}
            <a
              href="{{ block.settings.button_link }}"
              class="troopod-bundle-button"
            >
              {{ block.settings.button_label }}
            </a>
          {% endif %}

        </article>

      {% endfor %}

    </div>

    {% if section.settings.footer_text != blank %}
      <div class="troopod-bundles-footer">
        <span>{{ section.settings.footer_label }}</span>
        <p>{{ section.settings.footer_text }}</p>
      </div>
    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Footer label",
      "default": "More ways to save"
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Choose the bundle that works best for your home."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured bundle",
          "default": false
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "You save ₹398"
        },
        {
          "type": "text",
          "id": "badge_label",
          "label": "Badge label",
          "default": "Most popular"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in bundle",
          "limit": 5
        },
        {
          "type": "textarea",
          "id": "benefits",
          "label": "Benefits",
          "info": "Enter one benefit per line."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Bundle name",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "product_count",
          "label": "Product count",
          "default": "3"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Bundle price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare-at price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "saving",
          "label": "Saving text",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "terms",
          "label": "Small print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "bundle",
          "settings": {
            "featured": true,
            "badge": "You save ₹398",
            "badge_label": "Most popular",
            "title": "Kitchen essentials",
            "product_count": "3",
            "price": "₹499",
            "compare_price": "₹897",
            "saving": "Save ₹398"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "badge": "You save ₹448",
            "title": "Laundry care bundle",
            "product_count": "3",
            "price": "₹499",
            "compare_price": "₹947",
            "saving": "Save ₹448"
          }
        },
        {
          "type": "bundle",
          "settings": {
            "badge": "Biggest saving",
            "badge_label": "Best value",
            "title": "Complete home bundle",
            "product_count": "5",
            "price": "₹799",
            "compare_price": "₹1,495",
            "saving": "Save ₹696"
          }
        }
      ]
    }
  ]
}
{% endschema %}
