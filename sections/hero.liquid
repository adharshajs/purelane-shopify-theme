<section class="troopod-hero" data-scene="1">
  <div class="troopod-hero-grid">

    <!-- Desktop promise badges -->
    <div class="troopod-hero-badges" aria-label="Product promises">

      <div class="troopod-hero-badge">
        <span class="troopod-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
        </span>
        <span>Plant<br>powered</span>
      </div>

      <div class="troopod-hero-badge">
        <span class="troopod-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
        </span>
        <span>Safe for<br>kids &amp; pets</span>
      </div>

      <div class="troopod-hero-badge">
        <span class="troopod-badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
        </span>
        <span>Zero harsh<br>chemicals</span>
      </div>

    </div>

    <!-- Hero copy -->
    <div class="troopod-hero-copy">

      <h1 class="troopod-hero-title">
        Clean<br>
        That<br>
        <span>Lasts</span>
      </h1>

      <div class="troopod-hero-rule">
        <i></i>

        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <i></i>
      </div>

      <p class="troopod-hero-lede">
        Homecare that works on the toughest grime, made from plants.
        Kind to your home, your family and the world outside it.
      </p>

      <div class="troopod-hero-cta">

        <a class="troopod-btn troopod-btn-primary" href="/collections/all">
          Shop now

          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h13"/>
            <path d="m13 6 6 6-6 6"/>
          </svg>
        </a>

        <a class="troopod-btn troopod-btn-ghost" href="#how">
          How it works
        </a>

      </div>

      <!-- Mobile badge strip -->
      <div class="troopod-badge-strip">

        <div>
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
            <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          Plant powered
        </div>

        <div>
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/>
            <path d="m9 12 2.2 2.2L15.4 10"/>
          </svg>
          Kids &amp; pet safe
        </div>

        <div>
          <svg viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="1.6"
            stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="8.4"/>
            <path d="M6.4 17.6 17.6 6.4"/>
          </svg>
          Zero harsh chem
        </div>

      </div>

    </div>

    <!-- Product stage -->
    <div class="troopod-hero-product" id="troopodHeroProduct">

      <div class="troopod-product-stage" id="troopodProductStage">

        <!-- Single product -->
        <div class="troopod-product-slide is-active" data-product="1">

          <span
            class="troopod-product-image troopod-product-kitchen"
            role="img"
            aria-label="Purelane foaming kitchen cleaner spray bottle">
          </span>

          <div class="troopod-price-card">
            <span class="troopod-price-label">
              Single bottle
            </span>

            <span class="troopod-price-value">
              <strong>₹200</strong>
              <s>₹299</s>
            </span>

            <span class="troopod-price-off">
              33% off
            </span>
          </div>

        </div>

        <!-- Two products -->
        <div class="troopod-product-slide" data-product="2">

          <span
            class="troopod-product-image troopod-product-tap"
            role="img"
            aria-label="Purelane tap cleaner and limescale remover spray bottle">
          </span>

          <span
            class="troopod-product-image troopod-product-kitchen troopod-product-two"
            role="img"
            aria-label="Purelane foaming kitchen cleaner spray bottle">
          </span>

          <div class="troopod-price-card">
            <span class="troopod-price-label">
              Any 2 products
            </span>

            <span class="troopod-price-value">
              <strong>₹349</strong>
              <s>₹598</s>
            </span>

            <span class="troopod-price-off">
              Save ₹249
            </span>
          </div>

        </div>

        <!-- Three products -->
        <div class="troopod-product-slide" data-product="3">

          <span
            class="troopod-product-image troopod-product-tap"
            role="img"
            aria-label="Purelane tap cleaner and limescale remover spray bottle">
          </span>

          <span
            class="troopod-product-image troopod-product-metal"
            role="img"
            aria-label="Purelane copper, bronze and brass cleaner pump bottle">
          </span>

          <span
            class="troopod-product-image troopod-product-kitchen troopod-product-three"
            role="img"
            aria-label="Purelane foaming kitchen cleaner spray bottle">
          </span>

          <div class="troopod-price-card">
            <span class="troopod-price-label">
              Any 3 products
            </span>

            <span class="troopod-price-value">
              <strong>₹499</strong>
              <s>₹897</s>
            </span>

            <span class="troopod-price-off">
              Save ₹398
            </span>
          </div>

        </div>

      </div>

      <!-- Product dots -->
      <div class="troopod-product-dots" id="troopodProductDots">

        <button
          type="button"
          class="is-active"
          data-slide="1"
          aria-label="Show 1 product">
        </button>

        <button
          type="button"
          data-slide="2"
          aria-label="Show 2 products">
        </button>

        <button
          type="button"
          data-slide="3"
          aria-label="Show 3 products">
        </button>

      </div>

    </div>

  </div>
</section>

<script>
(function () {
  const section = document.querySelector('.troopod-hero');

  if (!section) return;

  const slides = section.querySelectorAll('.troopod-product-slide');
  const dots = section.querySelectorAll('.troopod-product-dots button');

  if (!slides.length || !dots.length) return;

  let current = 0;
  let timer;

  function showSlide(index) {
    current = index;

    slides.forEach((slide, i) => {
      slide.classList.toggle('is-active', i === index);
    });

    dots.forEach((dot, i) => {
      dot.classList.toggle('is-active', i === index);
    });
  }

  function nextSlide() {
    showSlide((current + 1) % slides.length);
  }

  dots.forEach((dot, index) => {
    dot.addEventListener('click', function () {
      showSlide(index);

      clearInterval(timer);

      timer = setInterval(nextSlide, 4500);
    });
  });

  showSlide(0);

  timer = setInterval(nextSlide, 4500);
})();
</script>

{% schema %}
{
  "name": "Troopod Hero",
  "settings": [],
  "presets": [
    {
      "name": "Troopod Hero"
    }
  ]
}
{% endschema %}
