<section class="troopod-why" id="why-it-works">
  <div class="troopod-why-inner">

    <div class="troopod-why-heading">

      {% if section.settings.eyebrow != blank %}
        <p class="troopod-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>
        {{ section.settings.heading }}
      </h2>

      {% if section.settings.description != blank %}
        <p class="troopod-why-description">
          {{ section.settings.description }}
        </p>
      {% endif %}

      {% if section.settings.link_label != blank %}
        <a
          class="troopod-why-link"
          href="{{ section.settings.link_url }}"
        >
          {{ section.settings.link_label }}
          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}

    </div>

    <div class="troopod-why-grid">

      {% for block in section.blocks %}
        <article
          class="troopod-why-stat"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.icon != blank %}
            <div class="troopod-why-feature-icon">
              {{ block.settings.icon }}
            </div>
          {% endif %}

          {% if block.settings.stat != blank %}
            <strong>{{ block.settings.stat }}</strong>
          {% endif %}

          {% if block.settings.title != blank %}
            <h4>{{ block.settings.title }}</h4>
          {% endif %}

          {% if block.settings.description != blank %}
            <p>{{ block.settings.description }}</p>
          {% endif %}

        </article>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Why it works",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime. Gentle on everything else."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon or symbol",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "stat",
          "label": "Large statistic",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Germ kill"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why it works",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "stat": "99.9%",
            "title": "Germ kill",
            "description": "Tested against germs and bacteria"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "0%",
            "title": "Sulphates",
            "description": "No SLS, chlorine or parabens"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "100%",
            "title": "Plant based",
            "description": "Cleansers derived from plants"
          }
        },
        {
          "type": "stat",
          "settings": {
            "stat": "4.8",
            "title": "Rated",
            "description": "Across verified customer reviews"
          }
        }
      ]
    }
  ]
}
{% endschema %}
